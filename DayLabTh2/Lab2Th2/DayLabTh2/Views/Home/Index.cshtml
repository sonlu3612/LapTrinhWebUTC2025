@model IEnumerable<DayLabTh2.Models.Student>   
@{
    ViewData["Title"] = "Student List";
}

<h1>Student List</h1>

<a asp-controller="Home" asp-action="Create" class="btn btn-primary mb-3">Create Student</a>   <!-- tạm để Home, sau này sửa -->

<table class="table table-striped table-hover" id="dataTable">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Lớp</th>
            <th>Giới tính</th>
            <th>ĐT</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FullName</td>
                <td>@item.Dob:dd/MM/yyyy)</td>
                <td>@item.Class</td>
                <td>@item.Gender</td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable();
        });
    </script>
}